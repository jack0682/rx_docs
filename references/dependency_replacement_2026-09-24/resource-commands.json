    "exit_code": 0
  },
  {
    "label": "outside-supervisor",
    "argv": [
      "docker",
      "exec",
      "rx-resources-current-09b7886d5f",
      "/usr/bin/python3",
      "-c",
      "import os,json,sqlite3; c=sqlite3.connect('file:/var/lib/rx-solutions/managed/supervisor.db?mode=ro',uri=True); s=json.loads(c.execute(\"select document from entities where key='supervisor/state'\").fetchone()[0])['value']; p=s['records']['status']['pid']; print(json.dumps({'observer_pid':os.getpid(),'supervisor_pid':1,'child_pid':p,'child_limits':open('/proc/%s/limits'%p).read(),'supervisor_limits':open('/proc/1/limits').read(),'child_cmdline':open('/proc/%s/cmdline'%p,'rb').read().decode().split(chr(0)),'resource_history':s['records']['status']['resources']}))"
    ],
    "exit_code": 0
  },
  {
    "label": "current-stop",
    "argv": [
      "docker",
      "stop",
      "--timeout",
