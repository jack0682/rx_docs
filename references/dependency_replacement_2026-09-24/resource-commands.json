[
  {
    "label": "resident-passage",
    "argv": [
      "/opt/homebrew/opt/python@3.14/bin/python3.14",
      "<workspace>/rx-solutions/tools/resident_registration_passage.py",
      "--image",
      "rx-solutions:n5-runtime",
      "--builder",
      "rust:1.98.1-slim-bookworm",
      "--evidence",
      "<workspace>/.f11-evidence/resource-final/resident"
    ],
    "exit_code": 0
  },
  {
    "label": "fixture-build",
    "argv": [
      "docker",
      "run",
      "--rm",
      "-v",
      "<workspace>/rx-solutions:/source:ro",
      "-v",
      "<workspace>/.f11-evidence/resource-final/resident:/evidence",
      "-w",
      "/source",
      "-e",
      "CARGO_HOME=/evidence/cargo-home",
      "--entrypoint",
      "cargo",
      "sha256:ff521445a372125ed4f76e1453a1f8098f2d05332d1601d30db1c1f62757e730",
      "test",
      "--locked",
      "-p",
      "rx-supervisor",
      "--lib",
      "--test",
      "resource_enforcement",
      "--no-run",
      "--target-dir",
      "/evidence/target",
      "--message-format=json"
    ],
    "exit_code": 0
  },
  {
    "label": "fixture-resource_enforcement",
    "argv": [
      "docker",
      "run",
      "--rm",
      "--network",
      "none",
      "--read-only",
      "--cap-drop",
      "ALL",
      "--security-opt",
      "no-new-privileges",
      "--tmpfs",
      "/tmp:rw",
      "-v",
      "<workspace>/.f11-evidence/resource-final/resident:/evidence:ro",
      "--entrypoint",
      "/evidence/target/debug/deps/resource_enforcement-21097e811c4f7af4",
